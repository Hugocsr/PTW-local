{
  "name": "ptw-api",
  "private": true,
  "version": "1.0.0-fase1",
  "description": "PTW in a Box · API (Fastify + postgres). Contrato: openapi.yaml.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p . && node scripts/resolve-dist.mjs",
    "typecheck": "tsc -p . --noEmit",
    "start": "node dist/server.js",
    "test": "vitest run",
    "lint": "eslint src test",
    "check": "node scripts/sync-shared.mjs --check && tsc -p . --noEmit && eslint src test && vitest run",
    "gen:api": "npx --yes openapi-typescript@7.13.0 openapi.yaml -o src/contract/schema.d.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "aws4fetch": "^1.0.20",
    "fastify": "^5.12.8",
    "ldapts": "^9.2.0",
    "postgres": "^4.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^24",
    "eslint": "^10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vitest": "^5.1.0"
  }
}
