# Borda do sistema: HTTPS com a CA interna do Caddy (não depende de internet) e os arquivos do app.
# Endereços atendidos: PTW_HOSTS, separados por vírgula (ex.: "ptw.planta.local, 10.0.0.20").
{
	admin off
	http_port 8080
	https_port 8443
	skip_install_trust
	servers {
		protocols h1 h2
	}
}

http://:8080 {
	redir https://{host}{uri} permanent
}

{$PTW_HOSTS:localhost} {
	tls internal
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(self), microphone=(self), geolocation=()"
		# Só o próprio servidor; fotos capturadas viram blob:/data: no navegador.
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
		-Server
	}

	# API interna; SSE sem espera e upload em fluxo.
	handle /api/* {
		header Cache-Control "no-store"
		request_body {
			max_size 2200MB
		}
		reverse_proxy api:3000 {
			flush_interval -1
		}
	}

	# Recursos dos contêineres para o rodapé, gravado pelo serviço "stats" a cada 5 s.
	# Sem o arquivo (stats nunca rodou), responde que está ausente, sem 404.
	handle /status.json {
		header Cache-Control "no-store"
		root * /status
		route {
			@tem file
			file_server @tem
			header Content-Type "application/json; charset=utf-8"
			respond `{"v":1,"absent":true}` 200
		}
	}

	# Tema da planta (nome, logotipo, cores, fonte): a pasta ./tema do servidor, trocável sem reconstruir
	# nada. Sem um arquivo lá, vale o que veio com o app (o tema padrão em /srv/tema).
	handle /tema/* {
		header Cache-Control "no-cache"
		@planta file {
			root /planta
		}
		handle @planta {
			root * /planta
			file_server
		}
		handle {
			root * /srv
			file_server
		}
	}

	handle {
		root * /srv
		# Arquivos com hash no nome: cache longo. index.html: sempre revalida.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@app not path /assets/*
		header @app Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
